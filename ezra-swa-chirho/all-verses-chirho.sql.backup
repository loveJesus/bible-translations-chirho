-- c001-v001: kwa mwaka kwa mfalme Kurusu kwa neno BABA kutoka kutoka kwa kumbariki kwa kumbariki juu-ya kila harusi kwa kujenga nyumba ya BABA kwa Yerusalemu
-- c001-v002: na Dareyeshi mfalme akataka kujua habari ya Israeli na sambamba na Yerusalemu

BEGIN;
-- === Chapter 1 Verse 1 ===
-- 1500100101: וּבִשְׁנַ֣ת (H8141) → "kwa" [claude-haiku-4.5-chirho]
WITH np AS (
  INSERT INTO phrase (language_id, created_at)
  SELECT (SELECT id FROM language WHERE code = 'swa'), NOW()
  WHERE NOT EXISTS (
    SELECT 1 FROM phrase p JOIN phrase_word pw ON pw.phrase_id = p.id
    WHERE pw.word_id = '1500100101' AND p.language_id = (SELECT id FROM language WHERE code = 'swa') AND p.deleted_at IS NULL
  )
  RETURNING id
)
INSERT INTO phrase_word (phrase_id, word_id) SELECT id, '1500100101' FROM np ON CONFLICT DO NOTHING;
INSERT INTO gloss (phrase_id, gloss, state, updated_at, source)
SELECT p.id, 'kwa', 'UNAPPROVED', NOW(), 'IMPORT'
FROM phrase p JOIN phrase_word pw ON pw.phrase_id = p.id
WHERE pw.word_id = '1500100101' AND p.language_id = (SELECT id FROM language WHERE code = 'swa') AND p.deleted_at IS NULL
ON CONFLICT (phrase_id) DO UPDATE SET gloss = EXCLUDED.gloss, updated_at = EXCLUDED.updated_at, source = EXCLUDED.source;
